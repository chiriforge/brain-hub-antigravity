{
  "name": "brain-hub-antigravity",
  "displayName": "Brain Hub for Antigravity",
  "description": "Search, view, resume, and sync Antigravity Brain sessions across machines.",
  "version": "0.5.1",
  "publisher": "hungle-vn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hungle-vn/brain-hub-antigravity.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "categories": [
    "AI",
    "Chat",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "antigravity",
    "chat",
    "history",
    "gemini",
    "deepmind",
    "ai",
    "transcript",
    "sync",
    "github",
    "threads",
    "dashboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-history",
          "title": "Brain Hub for Antigravity",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-history": [
        {
          "id": "antigravityHistory.treeView",
          "name": "Chat Sessions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravityHistory.openDashboard",
        "title": "Open Brain Hub Dashboard",
        "icon": "$(screen-full)"
      },
      {
        "command": "antigravityHistory.openSettings",
        "title": "Open Brain Hub Settings",
        "icon": "$(gear)"
      },
      {
        "command": "antigravityHistory.syncNow",
        "title": "Sync Brain Hub with GitHub (Pull & Push)",
        "icon": "$(github)"
      },
      {
        "command": "antigravityHistory.setupGitSync",
        "title": "Setup GitHub Backup Repository...",
        "icon": "$(repo)"
      },
      {
        "command": "antigravityHistory.checkGitStatus",
        "title": "Check GitHub Sync Status",
        "icon": "$(info)"
      },
      {
        "command": "antigravityHistory.refresh",
        "title": "Scan and refresh all chat sessions from disk",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravityHistory.searchChat",
        "title": "Search Chat History...",
        "icon": "$(search)"
      },
      {
        "command": "antigravityHistory.toggleWorkspaceFilter",
        "title": "Filter chat history by current workspace",
        "icon": "$(filter)"
      },
      {
        "command": "antigravityHistory.openChat",
        "title": "Open Chat in Brain Hub",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "antigravityHistory.copyResumePrompt",
        "title": "Copy Resume Prompt",
        "icon": "$(debug-continue)"
      },
      {
        "command": "antigravityHistory.copySessionId",
        "title": "Copy Session ID",
        "icon": "$(copy)"
      },
      {
        "command": "antigravityHistory.exportMarkdown",
        "title": "Export to Markdown (.md)",
        "icon": "$(export)"
      },
      {
        "command": "antigravityHistory.openFolder",
        "title": "Open Session Folder in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "antigravityHistory.deleteSession",
        "title": "Delete Chat Session (Xóa phiên chat)",
        "icon": "$(trash)"
      },
      {
        "command": "antigravityHistory.cleanEmptySessions",
        "title": "Scan and clean up all empty chat session directories (0 messages)",
        "icon": "$(clear-all)"
      },
      {
        "command": "antigravityHistory.toggleHideEmptySessions",
        "title": "Toggle Hide Empty Chats (Hide 0-message sessions)",
        "icon": "$(eye-closed)"
      },
      {
        "command": "antigravityHistory.exportProjectDocs",
        "title": "Archive Project Docs & Logs (.docs/)",
        "icon": "$(book)"
      },
      {
        "command": "antigravityHistory.exportAllWorkspaceSessions",
        "title": "Batch Export Workspace Sessions to Markdown...",
        "icon": "$(files)"
      },
      {
        "command": "antigravityHistory.openRichMarkdownPreview",
        "title": "Brain Hub: Open Rich Markdown Preview (Mermaid & KaTeX)",
        "icon": "$(search)"
      },
      {
        "command": "antigravityHistory.openIdeMarkdownPreview",
        "title": "Open with IDE Built-in Markdown Preview",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "antigravityHistory.openRichMarkdownPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "antigravityHistory.openRichMarkdownPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "antigravityHistory.openDashboard",
          "when": "view == antigravityHistory.treeView",
          "group": "navigation@0"
        },
        {
          "command": "antigravityHistory.syncNow",
          "when": "view == antigravityHistory.treeView",
          "group": "navigation@1"
        },
        {
          "command": "antigravityHistory.openSettings",
          "when": "view == antigravityHistory.treeView",
          "group": "navigation@2"
        },
        {
          "command": "antigravityHistory.refresh",
          "when": "view == antigravityHistory.treeView",
          "group": "navigation@3"
        },
        {
          "command": "antigravityHistory.searchChat",
          "when": "view == antigravityHistory.treeView",
          "group": "navigation@4"
        },
        {
          "command": "antigravityHistory.toggleWorkspaceFilter",
          "when": "view == antigravityHistory.treeView",
          "group": "navigation@5"
        },
        {
          "command": "antigravityHistory.toggleHideEmptySessions",
          "when": "view == antigravityHistory.treeView",
          "group": "navigation@6"
        },
        {
          "command": "antigravityHistory.exportProjectDocs",
          "when": "view == antigravityHistory.treeView",
          "group": "4_export@1"
        },
        {
          "command": "antigravityHistory.exportAllWorkspaceSessions",
          "when": "view == antigravityHistory.treeView",
          "group": "4_export@2"
        },
        {
          "command": "antigravityHistory.setupGitSync",
          "when": "view == antigravityHistory.treeView",
          "group": "2_sync@1"
        },
        {
          "command": "antigravityHistory.checkGitStatus",
          "when": "view == antigravityHistory.treeView",
          "group": "2_sync@2"
        },
        {
          "command": "antigravityHistory.cleanEmptySessions",
          "when": "view == antigravityHistory.treeView",
          "group": "3_clean@1"
        }
      ],
      "view/item/context": [
        {
          "command": "antigravityHistory.openChat",
          "when": "viewItem == sessionItem",
          "group": "inline@1"
        },
        {
          "command": "antigravityHistory.copyResumePrompt",
          "when": "viewItem == sessionItem",
          "group": "1_actions@1"
        },
        {
          "command": "antigravityHistory.copySessionId",
          "when": "viewItem == sessionItem",
          "group": "1_actions@2"
        },
        {
          "command": "antigravityHistory.exportMarkdown",
          "when": "viewItem == sessionItem",
          "group": "1_actions@3"
        },
        {
          "command": "antigravityHistory.openFolder",
          "when": "viewItem == sessionItem",
          "group": "2_system@1"
        },
        {
          "command": "antigravityHistory.deleteSession",
          "when": "viewItem == sessionItem",
          "group": "3_manage@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "antigravityHistory.searchChat",
        "key": "ctrl+k ctrl+h",
        "mac": "cmd+k cmd+h"
      },
      {
        "command": "antigravityHistory.openDashboard",
        "key": "ctrl+k ctrl+d",
        "mac": "cmd+k cmd+d"
      }
    ],
    "configuration": {
      "title": "Brain Hub for Antigravity",
      "properties": {
        "antigravityHistory.brainPath": {
          "type": "string",
          "default": "",
          "description": "Primary path to Antigravity brain directory (defaults to ~/.gemini/antigravity-ide/brain)"
        },
        "antigravityHistory.additionalBrainPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional folder paths to scan and merge alongside the primary brain folder (e.g. cloned Git repositories or external backups)"
        },
        "antigravityHistory.machineName": {
          "type": "string",
          "default": "",
          "description": "Custom PC/Machine name label for sessions created on this machine (defaults to system hostname)"
        },
        "antigravityHistory.sessionSortBy": {
          "type": "string",
          "enum": [
            "lastModified",
            "createdAt"
          ],
          "enumDescriptions": [
            "Sort by time of the last message / latest activity (Theo thời gian tin nhắn cuối cùng)",
            "Sort by time when chat was created (Theo thời gian tạo chat)"
          ],
          "default": "lastModified",
          "description": "Sorting criteria for the chat sessions list (default: sort by last message time)"
        },
        "antigravityHistory.messageOrder": {
          "type": "string",
          "enum": [
            "newestFirst",
            "oldestFirst"
          ],
          "enumDescriptions": [
            "Show newest messages at the top (💬 Newest First)",
            "Show oldest messages at the top (💬 Oldest First)"
          ],
          "default": "newestFirst",
          "description": "Default sorting order of messages in chat transcript viewer"
        },
        "antigravityHistory.autoSyncOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync with GitHub in background when VS Code starts up"
        },
        "antigravityHistory.autoSyncIntervalMinutes": {
          "type": "number",
          "default": 30,
          "description": "Interval in minutes for automatic background Git synchronization (set to 0 to disable periodic sync)"
        },
        "antigravityHistory.backgroundScanIntervalMinutes": {
          "type": "number",
          "default": 5,
          "description": "Interval in minutes for automatic background scanning of new chat sessions (Chu kỳ quét ngầm tìm chat mới mỗi 5 phút; đặt 0 để tắt)"
        },
        "antigravityHistory.enableRealtimeWatcher": {
          "type": "boolean",
          "default": true,
          "description": "Automatically monitor the brain folder in real-time for newly created or deleted chat sessions (Tự động giám sát thư mục brain để phát hiện chat mới ngay lập tức)"
        },
        "antigravityHistory.autoRefreshOnWindowFocus": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh chat sessions when switching focus back to this IDE window (Tự động làm mới khi chuyển lại cửa sổ IDE)"
        },
        "antigravityHistory.filterWorkspaceByDefault": {
          "type": "boolean",
          "default": false,
          "description": "Filter chat history by current workspace by default"
        },
        "antigravityHistory.hideEmptySessions": {
          "type": "boolean",
          "default": true,
          "description": "Hide empty chat sessions that contain no messages or prompts (Tự động ẩn các phiên chat rỗng 0 tin nhắn)"
        },
        "antigravityHistory.autoReloadOnLiveChat": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reload and stream updates when the active chat transcript file changes (Tự động cập nhật theo thời gian thực khi hội thoại đang xem có tin nhắn mới)"
        },
        "antigravityHistory.defaultToolsState": {
          "type": "string",
          "enum": [
            "collapsed",
            "expanded"
          ],
          "enumDescriptions": [
            "Tools collapsed by default (🛠️ Collapsed - Recommended)",
            "Tools expanded by default (🛠️ Expanded)"
          ],
          "default": "collapsed",
          "description": "Default expand/collapse state for tool execution details"
        },
        "antigravityHistory.defaultAiStepsState": {
          "type": "string",
          "enum": [
            "collapsed",
            "expanded"
          ],
          "enumDescriptions": [
            "Autonomous AI action groups collapsed by default (⚡ Collapsed - Recommended)",
            "Autonomous AI action groups expanded by default (⚡ Expanded)"
          ],
          "default": "collapsed",
          "description": "Default expand/collapse state for autonomous AI execution steps"
        },
        "antigravityHistory.maxQuickSearchItems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of items to index for Quick Search"
        },
        "antigravityHistory.autoOpenDashboardOnSidebarFocus": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Brain Hub Dashboard in the main editor window when clicking the Antigravity Activity Bar icon."
        },
        "antigravityHistory.archiver.defaultMode": {
          "type": "string",
          "enum": [
            "askEachTime",
            "safeDocsOnly",
            "fullWithSanitization"
          ],
          "enumDescriptions": [
            "Always ask with options popup (🛡️ Hỏi xác nhận mỗi lần chạy)",
            "Safe Architecture Docs Only - Plans/Walkthroughs/Diagrams only, skips raw transcripts (🛡️ Khuyến nghị)",
            "Full Archive with Secret Redaction & .gitignore protection (📋 Toàn bộ tài liệu kèm log đã khử trùng)"
          ],
          "default": "askEachTime",
          "description": "Default mode when archiving workspace documentation to .docs/ folder"
        },
        "antigravityHistory.archiver.autoGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Automatically protect .gitignore by adding .docs/logs/ and .docs/scratch/ to prevent committing sensitive chat transcripts to Git (Tự động thêm .docs/logs/ vào .gitignore)"
        },
        "antigravityHistory.archiver.sanitizeSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect and redact API keys, tokens, passwords, and private keys when exporting markdown or archiving session logs (Tự động che giấu API keys, mật khẩu, tokens)"
        },
        "antigravityHistory.archiver.customSecretPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional custom regex patterns to detect and mask from exported logs and markdown documents (Danh sách regex tự định nghĩa để che dữ liệu nhạy cảm)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node esbuild.js",
    "package": "npx @vscode/vsce package --no-dependencies",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "marked": "^18.0.10",
    "marked-katex-extension": "^5.1.11"
  }
}
